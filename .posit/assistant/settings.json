{
  "permission": {
    "executeCode": {
      "*": "allow"
    },
    "bash": {
      "cd *": "allow",
      "cat *": "allow",
      "python3 *": "allow",
      "quarto render *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "sed *": "allow",
      "git status *": "allow",
      "echo *": "allow",
      "git diff *": "allow",
      "tail *": "allow",
      "git add *": "allow"
    },
    "edit": {
